# aulasv.com — stack CCA. Plantilla: edge_nginx la renderiza con envsubst al arrancar;
# los hostnames salen de DOMAIN_PREFIX vía scripts/hosts.sh (stage.aulasv.com, stageweb...).
#
#   ${CCA_APEX} / ${CCA_WWW} -> placeholder de mantenimiento (vps/static/colegiaturas)
#   ${CCA_WEB}    -> cca_web:80      (Astro estático)
#   ${CCA_CMS}    -> cca_cms:1337    (Strapi)
#   ${CCA_PORTAL} -> cca_portal:3000 (Portal Familiar)
#
# Certificados (lineage = hostname, ver scripts/init-ssl.sh):
#   live/${CCA_APEX} (apex + www), live/${CCA_WEB}, live/${CCA_CMS}, live/${CCA_PORTAL}

# HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${CCA_APEX} ${CCA_WWW} ${CCA_WEB}
                ${CCA_CMS} ${CCA_PORTAL};

    include /etc/nginx/snippets/acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

# Apex + www: placeholder de mantenimiento
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${CCA_APEX} ${CCA_WWW};

    ssl_certificate /etc/letsencrypt/live/${CCA_APEX}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CCA_APEX}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security-headers.conf;

    root /var/www/colegiaturas;
    index index.html;

    location / {
        try_files $uri /index.html;
    }
}

# Sitio público (Astro)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${CCA_WEB};

    ssl_certificate /etc/letsencrypt/live/${CCA_WEB}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CCA_WEB}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security-headers.conf;

    access_log /var/log/nginx/${CCA_WEB}.access.log main;
    error_log /var/log/nginx/${CCA_WEB}.error.log;

    location / {
        set $upstream http://cca_web:80;
        proxy_pass $upstream;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# CMS (Strapi: admin + API + media)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${CCA_CMS};

    ssl_certificate /etc/letsencrypt/live/${CCA_CMS}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CCA_CMS}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    access_log /var/log/nginx/${CCA_CMS}.access.log main;
    error_log /var/log/nginx/${CCA_CMS}.error.log;

    # Subida de medios desde el admin.
    client_max_body_size 100M;

    location / {
        set $upstream http://cca_cms:1337;
        proxy_pass $upstream;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# Portal Familiar (equivalente al bloque del Caddyfile original)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${CCA_PORTAL};

    ssl_certificate /etc/letsencrypt/live/${CCA_PORTAL}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CCA_PORTAL}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Accesos en JSON para monitoreo / fail2ban (ver cca/docs/portal-familiar.md).
    access_log /var/log/nginx/portal-padres.access.json json;
    error_log /var/log/nginx/portal-padres.error.log;

    # Foto (≤2 MB) + multipart; la API además limita el JSON a 64 KB.
    client_max_body_size 3m;

    # El healthcheck es solo para Docker (dentro de la red); desde internet no existe.
    location = /api/health {
        return 404;
    }

    location / {
        set $upstream http://cca_portal:3000;
        proxy_pass $upstream;
        include /etc/nginx/snippets/proxy.conf;
    }
}
