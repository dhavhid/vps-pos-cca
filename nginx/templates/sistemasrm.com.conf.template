# sistemasrm.com — stack POS. Plantilla: edge_nginx la renderiza con envsubst al arrancar;
# los hostnames salen de DOMAIN_PREFIX vía scripts/hosts.sh (stage.sistemasrm.com, stagepos...).
#
#   ${SRM_APEX}  -> website estático (/pos-backend/infra/website)
#   ${SRM_WWW}   -> 301 a ${SRM_APEX}
#   ${SRM_POS}   -> pos_static:3001
#   ${SRM_POSAPI} -> pos_api:3000
#
# Certificados (lineage = hostname, ver scripts/init-ssl.sh):
#   live/${SRM_APEX} (apex + www), live/${SRM_POS}, live/${SRM_POSAPI}

# HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${SRM_APEX} ${SRM_WWW} ${SRM_POS} ${SRM_POSAPI};

    include /etc/nginx/snippets/acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

# www -> apex
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SRM_WWW};

    ssl_certificate /etc/letsencrypt/live/${SRM_APEX}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SRM_APEX}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    return 301 https://${SRM_APEX}$request_uri;
}

# Apex: website estático
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SRM_APEX};

    ssl_certificate /etc/letsencrypt/live/${SRM_APEX}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SRM_APEX}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security-headers.conf;

    access_log /var/log/nginx/${SRM_APEX}.access.log main;
    error_log /var/log/nginx/${SRM_APEX}.error.log;

    root /var/www/sistemasrm;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Página 404 real, conservando el status 404 para los crawlers.
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|svg|webp|css|js|woff|woff2|ttf|eot)$ {
        expires 1y;
        include /etc/nginx/snippets/ssl-headers.conf;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Archivos ocultos
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}

# App POS (Expo web)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SRM_POS};

    ssl_certificate /etc/letsencrypt/live/${SRM_POS}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SRM_POS}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    access_log /var/log/nginx/${SRM_POS}.access.log main;
    error_log /var/log/nginx/${SRM_POS}.error.log;

    location / {
        set $upstream http://pos_static:3001;
        proxy_pass $upstream;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# API POS (NestJS)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SRM_POSAPI};

    ssl_certificate /etc/letsencrypt/live/${SRM_POSAPI}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SRM_POSAPI}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    access_log /var/log/nginx/${SRM_POSAPI}.access.log main;
    error_log /var/log/nginx/${SRM_POSAPI}.error.log;

    location / {
        set $upstream http://pos_api:3000;
        proxy_pass $upstream;
        include /etc/nginx/snippets/proxy.conf;
    }
}
