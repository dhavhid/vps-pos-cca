# Copiar a stacks/cca/portal.env. NUNCA commitear el real.

# PORTAL_PUBLIC_URL lo define stacks/cca/compose.yml según DOMAIN_PREFIX.
# Base del colegio en el cluster de DigitalOcean (tablas cca_*). Usuario con
# SELECT/INSERT/UPDATE, sin DDL — ver docs/postgres-do.md.
PORTAL_DATABASE_URL=postgres://portal_user:<password>@<cluster>.db.ondigitalocean.com:25060/<base>?sslmode=verify-full
# openssl rand -base64 48
PORTAL_SESSION_SECRET=
PORTAL_FECHA_LIMITE=Viernes 30 de octubre
PORTAL_ANIO_LECTIVO=2026
PORTAL_SESSION_HOURS=12
PORTAL_LINK_PER_EMAIL_PER_HOUR=3

# Cloudflare Turnstile. Vacías = desactivado. Ambas o ninguna.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portal Familiar <portal@aulasv.com>

PCLOUD_API_HOST=api.pcloud.com
PCLOUD_ACCESS_TOKEN=
PCLOUD_FOLDER_ID=
PCLOUD_PUBLIC_BASE_URL=https://filedn.com/<codigo>/cca_profile_pics

# Servicio de reportes interno (si el portal lo usa).
# JASPER_URL=http://jasperservice:8080/
# JASPER_API_KEY=
