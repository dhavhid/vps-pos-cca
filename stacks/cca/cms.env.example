# Copiar a stacks/cca/cms.env. NUNCA commitear el real.

# --- Postgres (cluster DigitalOcean) ---
DATABASE_HOST=<cluster>.db.ondigitalocean.com
DATABASE_PORT=25060
DATABASE_NAME=cca_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_SSL=true
# Verificación TLS con el CA montado vía NODE_EXTRA_CA_CERTS (secrets/do-postgres-ca.crt).
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Presupuesto de conexiones: ver docs/postgres-do.md.
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# --- Secretos de Strapi (openssl rand -base64 32; APP_KEYS = 2-4 valores separados por coma) ---
# Si migras contenido existente, REUTILIZA los mismos valores que el entorno de origen
# (ENCRYPTION_KEY/APP_KEYS distintos invalidan tokens y sesiones guardadas).
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
