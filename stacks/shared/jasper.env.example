# Copiar a stacks/shared/jasper.env.
# jasperservice es interno (red "services"): http://jasperservice:8080
# Conexión JDBC al cluster de DigitalOcean (SSL; puerto 25060 directo o 25061 si usas un pool).
DB_HOST=<cluster>.db.ondigitalocean.com
DB_PORT=25060
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# Todos los clientes (pos_api, cca_portal, ...) deben enviar esta key.
JASPER_API_KEY=
