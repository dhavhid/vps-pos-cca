# Copiar a .env (cp .env.example .env). Solo variables de interpolación de Compose;
# los secretos de cada app van en stacks/<stack>/*.env.

# Compose combina todos los stacks; `docker compose ...` desde vps/ opera sobre todo.
COMPOSE_PROJECT_NAME=vps
COMPOSE_FILE=compose.yml:stacks/shared/compose.yml:stacks/pos/compose.yml:stacks/cca/compose.yml

# Repos clonados en el VPS.
POS_BACKEND_DIR=/pos-backend
POS_FRONTEND_DIR=/pos-frontend
CCA_DIR=/cca

# Email para Let's Encrypt (avisos de expiración).
LE_EMAIL=rm.davimar@gmail.com

# URL pública del CMS que cca_web usa EN BUILD TIME.
STRAPI_PUBLIC_URL=https://cms-web.colegiaturas.com

# Memoria máxima de la JVM de jasperservice.
JASPER_MEM_LIMIT=1g
